# ==========================================
# Video Insight Spec - Environment Variables
# ==========================================

# ------------------------------------------
# 1. Secrets (API Keys)
# ------------------------------------------
# Streamlit ダッシュボードの AI 分析（NarrativeEngine）で使用
OPENAI_API_KEY=

# 動画情報の取得等（YouTubeMetadataServiceなど）で使用
YOUTUBE_API_KEY=

# 動画分析時のテキスト/情報抽出（GeminiKnowledgeLabelerなど）で使用
GEMINI_API_KEY=


# ------------------------------------------
# 2. Configuration (Directories & Paths)
# ------------------------------------------
# 動画ファイルの入力元ディレクトリ
VIDEOS_INPUT_DIR=D:\AI_Data\video-insight-spec\downloaded_videos

# バッチ処理などの一時作業ディレクトリ
TEMP_DIR=./batch_refine_work

# 処理済みデータの出力先・参照先ディレクトリ
ARCHIVE_OUTPUT_DIR=D:\AI_Data\video-insight-spec\archive

# ログ出力先ディレクトリ
LOGS_DIR=./logs

# (主にテスト用) Mk2_Core JSON と Mk2_Sidecar DB のパス
REAL_CORE_JSON_PATH=
REAL_SIDECAR_DB_PATH=
TEST_OUTPUT_DIR=./test_output


# ------------------------------------------
# 3. Configuration (Processing Settings)
# ------------------------------------------
# Gemini 使用時のモデル名（デフォルト: gemini-3-pro-preview）
GEMINI_MODEL_ID=gemini-3-pro-preview

# Whisper のモデルサイズ（デフォルト: small）
WHISPER_MODEL_SIZE=small

# Whisper 処理デバイス（デフォルト: cpu または cuda）
WHISPER_DEVICE=cpu

# EasyOCR の GPU 使用フラグ（デフォルト: false）
EASYOCR_GPU=false

# EasyOCR 抽出言語（デフォルト: ja,en）
EASYOCR_LANGUAGES=ja,en

# 動画からのフレーム抽出頻度（デフォルト: 3 フレーム/分）
FRAMES_PER_MINUTE=3

# ffmpeg 実行パス（デフォルト: ffmpeg）
FFMPEG_PATH=ffmpeg
